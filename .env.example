APP_NAME="Sistem Reservasi Ruangan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservasi_ruangan
DB_USERNAME=root
DB_PASSWORD=

# Gunakan 'reverb' untuk real-time calendar updates & notification broadcasting
BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local

# PENTING DI PRODUCTION:
# Gunakan 'database' atau 'redis' agar pengiriman notifikasi email dan broadcasting
# diproses di latar belakang secara asinkron tanpa membebani request pengguna.
# Jalankan 'php artisan queue:work' di server production.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Konfigurasi SMTP Pengiriman Email Notifikasi
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@reservasi-ruangan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi Laravel Reverb (WebSocket Server)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Variabel Reverb untuk Frontend (Vite)
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
